{
	"name": "@localmind/n8n-nodes-localmind",
	"version": "0.1.0",
	"description": "n8n nodes for Localmind: agents, conversations, documents and files, plus a chat model for n8n's AI Agent",
	"license": "MIT",
	"homepage": "https://localmind.ai",
	"keywords": [
		"n8n-community-node-package",
		"localmind"
	],
	"author": {
		"name": "Localmind",
		"email": "support@localmind.ai",
		"url": "https://localmind.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Localmind-GmbH/localmind-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.test.json",
		"test:watch": "vitest",
		"check:package": "node scripts/check-package.mjs",
		"prepublishOnly": "node -e \"console.error('Publish only through the GitHub workflow: Actions > Publish > Run workflow (see RELEASING.md).'); process.exit(1)\""
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LocalmindApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Localmind/Localmind.node.js",
			"dist/nodes/LmChatLocalmind/LmChatLocalmind.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"@n8n/ai-node-sdk": "*",
		"n8n-workflow": "*"
	}
}
